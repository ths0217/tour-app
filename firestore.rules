rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is a member of the trip
    function isTripMember(tripData) {
      return isAuthenticated() && (request.auth.uid in tripData.members);
    }

    // Users Collection: Users can only read/write their own profile
    match /users/{userId} {
      allow read: if isAuthenticated(); // Allow reading other users (for family locator)
      allow write: if request.auth.uid == userId;
    }

    // Trips Collection
    match /trips/{tripId} {
      allow read: if isTripMember(resource.data);
      allow create: if isAuthenticated(); // Any auth user can create a trip
      allow update: if isTripMember(resource.data);

      // Subcollections (Schedule, Expenses)
      // Inherit access from parent trip
      match /schedule/{itemId} {
        allow read, write: if isTripMember(get(/databases/$(database)/documents/trips/$(tripId)).data);
      }
      
      match /expenses/{itemId} {
        allow read, write: if isTripMember(get(/databases/$(database)/documents/trips/$(tripId)).data);
      }
    }
  }
}
